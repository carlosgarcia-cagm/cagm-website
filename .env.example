# "Ask my CV" chat. The widget shows itself only when the server confirms it
# can answer: API key set, Redis reachable with quota left today, and DeepSeek
# balance available. Set CHAT_ENABLED=false to turn it off without removing keys.
# CHAT_ENABLED=true

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
# optional
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Upstash Redis for rate limiting (required on Vercel).
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead;
# either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# optional limits
# CHAT_IP_LIMIT=10        # questions per IP every 10 minutes
# CHAT_DAILY_LIMIT=300    # questions per day for the whole site
